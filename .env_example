# ─────────────────────────────────────────────────────────────────────────────
# WAEFER 환경변수 예시 (.env_example)
#   - `cp .env_example .env` 후 OPENAI_API_KEY / NEO4J_PASSWORD만 채우면 그대로 돈다.
#   - 주석 처리된 변수는 두지 않는다. 끄고 싶으면 지우지 말고 **0으로 명시**할 것 —
#     코드 기본값이 "켜짐"인 변수(KG_SEMANTIC 등)는 지우는 순간 끌 방법이 사라진다.
#   - 정말 안 쓰는 기능만 삭제하고, 되살릴 근거 문서를 그 자리 주석에 남긴다(VLM open 트랙 참고).
#   - 섹션 구조는 .env와 동일하게 유지할 것(두 파일 diff에 값 차이만 남도록).
#   - kg_rca·secsgem-mcp는 이 repo 하위 폴더다(0713 통합) — 상대경로가 그대로 맞다.
# ─────────────────────────────────────────────────────────────────────────────

# ── 핵심 경로 ────────────────────────────────────────────────────────────────
# KG 산출물 — backend가 읽는 원인 후보 파일(KG_LIVE=0일 때 이 파일만 조회).
KG_HYPOTHESES_PATH=./kg_rca/outputs/hypotheses.json
# secsgem-mcp 서버 — MCP stdio 서브프로세스의 작업 디렉터리/모듈 경로.
MCP_SERVER_CWD=./secsgem-mcp
MCP_SERVER_PYTHONPATH=./secsgem-mcp
# fab.db — 시뮬레이터가 만든 가상 팹 데이터(읽기 전용, git 밖 — secsgem-mcp README "데이터 준비").
FAB_DB=./secsgem-mcp/datasets/fab.db
# 서비스 런타임 상태 — 배치 커서·분석 결과(지우면 첫 배치부터 다시).
APP_STATE_DB=./app_state.db
# CNN 체크포인트 — 없으면 전 웨이퍼 "Center" 폴백(그룹 1개만 생김).
CNN_CKPT=./wafer_reading/classifier/checkpoints/resnet18_5cls.pt

# ── 서버 기준일 ──────────────────────────────────────────────────────────────
# 서버가 인식하는 "오늘"(벽시계 아님, 명세 §1). 배치는 이 날짜의 '전날'까지가 대상.
# 데이터가 2026-01~03월분이라 벽시계 now()를 쓰면 대상이 0건이 된다. 값은 데모 합의값(0727).
# ⚠️ 이 값이 설정돼 있으면 test_assembler.py::test_event_date_env_override 가 실패한다
#    (그 테스트는 코드 기본값 2026-04-01을 기대) — 테스트 돌릴 땐 잠시 주석 처리할 것.
EVENT_DATE=2026-02-06

# ── LLM — 역할 1개 = 변수 1개 ────────────────────────────────────────────────
# 정본: sdoubleoj/0726 work/모델지정_규약_설계서_v2.0.md §4
# 성격이 다른 역할이 한 스위치를 공유하면 한쪽을 튜닝할 때 나머지가 딸려 움직인다.
# 모델을 바꿀 땐 해당 역할 한 줄만 건드릴 것.
#
# ⚠️ temperature=0을 못 받는 모델(gpt-5.5·gpt-5.6 계열 — 1 고정 + top_p까지 거부)은
#    재현성이 필요한 역할(에이전트·번역·VLM·판정)에 넣지 말 것. 400으로 죽거나,
#    폴백으로 우회하면 실행마다 결과가 달라진다. 실측표는 설계서 v2.0 §3.1.
OPENAI_API_KEY=
RCA_AGENT_MODEL=gpt-5.4-2026-03-05     # ⑤ Hypothesis 자동 tier 에이전트
TRANSLATE_MODEL=gpt-5.4-2026-03-05     # ⑦ 응답 영→한 번역 (RESPONSE_LLM=1일 때만)
VLM_PTY_MODEL=gpt-5.4-2026-03-05       # ③ VLM 서술 pty 트랙
RUBRIC_GEN_MODEL=gpt-5.5-2026-04-23    # 루브릭 생성 (평가 전용)
JUDGE_MODEL=gpt-5.2-2025-12-11         # LLM-as-Judge (평가 전용)
# ↑ 위 셋(VLM/루브릭/판정)은 **서로 다른 세대여야 한다** — 같으면 자기평가 편향이 수치에
#   섞인다. 크기 변형(mini/nano/pro)도 같은 계열로 접어서 막는다(rubric_gen/models.py의
#   model_family + assert_distinct가 실행 시점에 검사).

# KG 구축은 위 체인과 **분리**돼 있다. 산출물(hypotheses.json 772건)이 고정 대상이라
# 런타임 모델을 티어업해도 따라 오르면 안 된다. 값을 바꾸면 재빌드 시 산출물이 통째로 바뀐다.
KG_EXTRACT_MODEL=gpt-5.4-mini          # kg_rca 5번 (KG 추출)
KG_SYNTH_MODEL=gpt-5.4-mini            # kg_rca 6번 (문장 합성 — **영어**로만 생성)
KG_TRANSLATE_MODEL=gpt-5.4-mini        # kg_rca 6번 (가설 문장 영→한 번역 패스)
# ↑ 0728 언어 규약: KG는 영어로 생성하고 한국어 전환은 **별도 번역 패스**가 전담한다.
#   한 LLM에 생성과 번역을 겹쳐 시키면 두 작업의 실패가 구분되지 않는다(③ VLM과 같은 경계).
#   번역은 빌드타임 1회로 끝나 산출물(hypotheses.json)에 구워지므로 런타임 비용은 0이다.
#   미설정이면 KG_SYNTH_MODEL을 그대로 쓴다.

# ── 실연동 스위치 ────────────────────────────────────────────────────────────
# KG_LIVE : 1이면 hypotheses.json 대신 Neo4j를 요청마다 직접 순회(LiveKGClient).
#           ⚠️ Neo4j 접속 필수 — 못 붙으면 ④ KG 조회에서 배치가 죽는다(Neo4jGraph가
#           생성 시점에 verify_connectivity()를 돌린다). 붙기 전에 아래로 먼저 확인:
#               python kg_rca/1_test_connection.py
#           0728부터 Neo4j는 **Aura(관리형 클라우드)** — EC2 데모 서버도 같은 인스턴스를
#           바라보므로 서버 .env에서도 1로 둘 수 있다(구 "서버엔 0" 지침 폐기).
#           ⚠️ 그래프 리빌드 중에는 0으로 내려둘 것 — 반쯤 적재된 그래프가 라이브로 나간다.
# VLM_LIVE: 1이면 ③ 관측에 실제 VLM 자연어 서술을 얹는다(그룹마다 API 호출 = 과금).
#           0이면 결정적 관측(die-matrix)만 — 배치는 정상 동작.
# RESPONSE_LLM: 1이면 ⑦ 응답 카드 서술을 한국어로 번역(0이면 영어 원문, LLM 비용 0).
KG_LIVE=1
VLM_LIVE=1
RESPONSE_LLM=1

# ── KG 의미 진입 (KG_LIVE=1일 때만 의미 있음) ────────────────────────────────
# VLM 자연어를 임베딩해 진입 시그니처를 고른다. signature index 파일이 있으면 자동 활성.
#KG_SEMANTIC=0                               # 0으로 명시하면 끔
#KG_SIGNATURE_INDEX_PATH=./kg_rca/outputs/signature_index.json
#
# 임베딩 모델 — 인덱스를 만든 모델과 질의 모델이 반드시 같아야 한다(벡터 공간이 달라짐).
# ⚠️ 바꾸면 인덱스를 **반드시 다시 만들어야 한다**(인덱스 파일에 벡터가 구워져 있어서,
#    모델만 바꾸면 옛 벡터가 그대로 남는다). Neo4j가 없어도 되는 모드가 있다:
#      python kg_rca/7_build_signature_index.py --reembed   ← 모델만 바뀐 경우(그래프 불필요)
#      python kg_rca/7_build_signature_index.py             ← 그래프도 바뀐 경우(Neo4j 필요)
# 재빌드를 잊어도 서버는 죽지 않는다 — 빌드 모델이 다르거나 차원이 어긋나면 의미 진입만
# 자동으로 꺼지고 enum/패턴 진입으로 계속 돈다(콘솔에 재빌드 안내가 찍힌다).
#KG_EMBEDDING_MODEL=text-embedding-3-small
#
# 코사인 하한. 점수 분포가 모델마다 달라 **모델을 바꾸면 다시 재야 하는 값**이다.
# 실측(text-embedding-3-small): 정답 0.53~0.71 / 오답 상위 0.44~0.48 → 0.4.
# 실측표(semantic_entry.MIN_MATCH_SCORE_BY_MODEL)에 없는 모델은 기동 시 "미보정" 경고가 뜬다.
#KG_SEMANTIC_MIN_SCORE=0.4

# ── VLM 트랙 ─────────────────────────────────────────────────────────────────
# pty(OpenAI API) | open(오픈웨이트 Qwen3-VL). open은 GPU 미확보로 **보류**다
# (0727 — sdoubleoj/0727 work/AWS_모델서빙_요구사항_v1.0.md 상단). 재개하려면 그 문서와
# wafer_reading/vlm/serving/README.md 의 VLM_OPEN_* 변수를 참고해 되살릴 것.
VLM_TRACK=pty

# ── Neo4j (KG 재빌드 kg_rca 0~7번 + KG_LIVE=1 라이브 조회에 필요) ─────────────
# 0728부터 **AuraDB(관리형)** — 로컬 설치 불필요. 콘솔(console.neo4j.io)에서 인스턴스를
# 만들면 자격증명 파일이 1회 내려온다(비밀번호는 그때만 표시되니 반드시 저장).
# URI 스킴이 bolt:// 가 아니라 **neo4j+s://**(TLS)다 — 코드는 그대로, 값만 바꾸면 된다.
# ⚠️ kg_rca 스크립트는 인자 없는 load_dotenv()라 실행 위치에 따라 루트 .env 또는
#    kg_rca/.env 를 읽는다. **두 파일의 NEO4J_* 4줄을 반드시 같게 유지할 것.**
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
# Aura는 DB 이름이 neo4j로 고정이다(별도 DB 생성 불가).
NEO4J_DATABASE=neo4j

# ── 옵저버빌리티 (Langfuse Cloud) ────────────────────────────────────────────
# LANGFUSE_TRACING 이 1 **이면서** 키 2종이 있을 때만 켜진다(deps.py:158·160 — 둘 중 하나만 있으면
# 경고 찍고 비활성). 키를 채우기 전까지는 0으로 두는 게 맞다.
# 설계 정본: docs/node_langraph_spec/langfuse_observability_설계공유_v1.0.md
LANGFUSE_TRACING=0
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://jp.cloud.langfuse.com
# span export HTTP 타임아웃(초). 기본 5초는 원거리 리전+대형 span에 짧아 유실됨.
LANGFUSE_TIMEOUT=60

# ── KG 재빌드 전용 (kg_rca 0~7번 스크립트에서만 — 서비스 실행에는 불필요) ─────
# ANCHOR_MODEL : 진입점 엣지(패턴→공정) 보강 패스만 쓰는 모델. 미설정 시 KG_EXTRACT_MODEL.
#   ⚠️ 상위 모델을 넣고 싶어도 gpt-5.5·5.6 계열은 넣지 말 것 — kg_rca 5번이 temperature=0으로
#      호출하는데 그 세대는 1 외의 값을 거부해 400으로 죽는다(설계서 v2.0 §3.1).
# ANCHOR_PASSES: 그 보강 패스 반복 횟수(추출 비결정성 완화용).
# TOP_K(패턴별 가설 출력 상한)는 미설정=전건 출력이라 값으로 표현할 수 없어 뺐다 —
#   잘라 보고 싶으면 `TOP_K=3 python kg_rca/6_ask_graphrag.py`처럼 일회성으로 줄 것.
ANCHOR_MODEL=gpt-5.4-mini
ANCHOR_PASSES=3
