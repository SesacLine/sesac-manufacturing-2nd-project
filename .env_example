# ─────────────────────────────────────────────────────────────────────────────
# WAEFER 환경변수 예시 (.env_example)
#   - `cp .env_example .env` 후 OPENAI_API_KEY만 채우면 기본 동작(파일 조회·실연동 off).
#   - 섹션 구조는 .env와 동일 — 새 변수가 생기면 두 파일을 같이 갱신할 것.
#   - kg_rca·secsgem-mcp는 이 repo 하위 폴더다(0713 통합) — 상대경로가 그대로 맞다.
# ─────────────────────────────────────────────────────────────────────────────

# ── 핵심 경로 ────────────────────────────────────────────────────────────────
# KG 산출물 — backend가 읽는 원인 후보 파일(KG_LIVE 미설정 시 이 파일만 조회).
KG_HYPOTHESES_PATH=./kg_rca/outputs/hypotheses.json
# secsgem-mcp 서버 — MCP stdio 서브프로세스의 작업 디렉터리/모듈 경로.
# (MCP_SERVER_PYTHONPATH는 생략 시 MCP_SERVER_CWD로 폴백 — client.py:46)
MCP_SERVER_CWD=./secsgem-mcp
MCP_SERVER_PYTHONPATH=./secsgem-mcp
# fab.db — 시뮬레이터가 만든 가상 팹 데이터(읽기 전용, git 밖 — secsgem-mcp README "데이터 준비").
FAB_DB=./secsgem-mcp/datasets/fab.db
# 서비스 런타임 상태 — 배치 커서·분석 결과(지우면 첫 배치부터 다시).
APP_STATE_DB=./app_state.db
# CNN 체크포인트 — 없으면 전 웨이퍼 "Center" 폴백(그룹 1개만 생김). 코드 기본값과 동일 경로.
#CNN_CKPT=./wafer_reading/classifier/checkpoints/resnet18_5cls.pt

# ── 서버 기준일 ──────────────────────────────────────────────────────────────
# 서버가 인식하는 "오늘"(벽시계 아님, 명세 §1). 배치는 이 날짜의 '전날'까지가 대상.
# 데이터가 2026-01~03월분이라 벽시계 now()를 쓰면 대상이 0건이 된다.
# 미설정 시 코드 기본값 2026-04-01(데이터축 직후). 데모 합의값은 2026-02-06(0727).
# ⚠️ 설정하면 test_assembler.py::test_event_date_env_override 가 실패한다(기본값 기대) —
#    테스트 돌릴 땐 주석 처리.
#EVENT_DATE=2026-02-06

# ── LLM ──────────────────────────────────────────────────────────────────────
# ⑤ Hypothesis 자동 tier 에이전트 · ⑦ 번역 · VLM pty 트랙 · KG 구축이 공용으로 쓴다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# ── 실연동 스위치 (코드 기본값은 전부 off — 여기서만 켠다) ────────────────────
# KG_LIVE : 1이면 hypotheses.json 대신 Neo4j를 요청마다 직접 순회(LiveKGClient).
#           ⚠️ 로컬 Neo4j 기동 필수 — 안 떠 있으면 ④ KG 조회에서 배치가 죽는다.
#           EC2(데모 서버)에는 Neo4j가 없으므로 서버 .env엔 넣지 말 것.
# VLM_LIVE: 1이면 ③ 관측에 실제 VLM 자연어 서술을 얹는다(그룹마다 API 호출 = 과금).
#           미설정이면 결정적 관측(die-matrix)만 — 배치는 정상 동작.
# RESPONSE_LLM: 1이면 ⑦ 응답 카드 서술을 한국어로 번역(미설정=영어 원문, LLM 비용 0).
#KG_LIVE=1
#VLM_LIVE=1
#RESPONSE_LLM=1

# ── KG 의미 진입 (KG_LIVE=1일 때만 의미 있음) ────────────────────────────────
# VLM 자연어를 임베딩해 진입 시그니처를 고른다. signature index 파일이 있으면 자동 활성.
#KG_SEMANTIC=0                               # 0으로 명시하면 끔
#KG_SIGNATURE_INDEX_PATH=./kg_rca/outputs/signature_index.json
#
# 임베딩 모델 — 인덱스를 만든 모델과 질의 모델이 반드시 같아야 한다(벡터 공간이 달라짐).
# ⚠️ 바꾸면 인덱스를 **반드시 다시 만들어야 한다**: python kg_rca/7_build_signature_index.py
#    (인덱스 파일에는 벡터가 구워져 있어서, 모델만 바꾸면 옛 벡터가 그대로 남는다)
# 재빌드를 잊어도 서버는 죽지 않는다 — 빌드 모델이 다르거나 차원이 어긋나면 의미 진입만
# 자동으로 꺼지고 enum/패턴 진입으로 계속 돈다(콘솔에 재빌드 안내가 찍힌다).
#KG_EMBEDDING_MODEL=text-embedding-3-small
#
# 코사인 하한. 점수 분포가 모델마다 달라 **모델을 바꾸면 다시 재야 하는 값**이다.
# 실측(text-embedding-3-small): 정답 0.53~0.71 / 오답 상위 0.44~0.48 → 0.4.
# 실측표(semantic_entry.MIN_MATCH_SCORE_BY_MODEL)에 없는 모델은 기동 시 "미보정" 경고가 뜬다.
#KG_SEMANTIC_MIN_SCORE=0.4

# ── Neo4j (KG 재빌드 kg_rca 0~7번 + KG_LIVE=1 라이브 조회에 필요) ─────────────
# 서비스만 돌릴 때는 없어도 된다(hypotheses.json 파일 조회로 동작).
#NEO4J_URI=bolt://localhost:7687
#NEO4J_USERNAME=neo4j
#NEO4J_PASSWORD=
#NEO4J_DATABASE=neo4j

# ── VLM 트랙 상세 ────────────────────────────────────────────────────────────
# 트랙: pty(OpenAI API, 기본 — GPU 불필요) | open(오픈웨이트 Qwen3-VL, opt-in)
#VLM_TRACK=pty
#VLM_PTY_MODEL=gpt-5.4-mini-2026-03-17      # pty 트랙 모델(핀 고정 기본값)
# open 트랙 — 가중치 사전 다운로드 전제(런타임 다운로드 없음): hf download Qwen/Qwen3-VL-8B-Instruct
#VLM_OPEN_MODEL=Qwen/Qwen3-VL-8B-Instruct
#VLM_OPEN_DEVICE_MAP=cuda:0                 # 로컬 모드 전용(기본 cuda:0, GPU 없으면 auto)
#VLM_OPEN_FAST_PATCHIFY=1                   # patch_embed 가속 우회(#24). 0이면 원본 경로(A/B용)
# open 원격 모드 — OpenAI 호환 서버(자체 호스팅 vLLM 등) 호출 → GPU 없는 팀원도 open 트랙 사용 가능.
# 서빙 구성: wafer_reading/vlm/serving/ (#102) · 설계 정본: sdoubleoj/0727 work/VLM_오픈모델_서빙_설계서_v1.0.md
#VLM_OPEN_BASE_URL=http://localhost:8001/v1
#VLM_OPEN_API_KEY=                          # 원격 서버 토큰(OPENAI_API_KEY와 별개)
#VLM_OPEN_SERVED_MODEL=                     # 서버가 다른 이름으로 모델을 알릴 때만(기본=VLM_OPEN_MODEL)

# ── 옵저버빌리티 (Langfuse Cloud, 선택 — LANGFUSE_TRACING=1일 때만 켜짐) ──────
# 미설정/0이면 트레이싱 완전 비활성(CI·미설정 환경 무영향) — KG_LIVE/RESPONSE_LLM과 같은 관례.
#LANGFUSE_TRACING=1
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://jp.cloud.langfuse.com
# span export HTTP 타임아웃(초). 기본 5초는 원거리 리전+대형 span에 짧아 유실됨 — 60초 권장.
#LANGFUSE_TIMEOUT=60

# ── 평가 전용 (서비스 런타임 무관 — 루브릭 평가 모듈 #93) ─────────────────────
# 역할 분리 원칙: 서술 VLM ≠ 루브릭 생성 ≠ 심판 모델(셋 다 달라야 함, rubric_gen/models.py).
#RUBRIC_GEN_MODEL=gpt-5.5-2026-04-23
#JUDGE_MODEL=

# ── KG 재빌드 전용 (kg_rca 0~7번 스크립트에서만 — 서비스 실행에는 불필요) ─────
# TOP_K        : 6_ask_graphrag.py의 패턴별 가설 출력 상한(미설정 = 전건 출력)
# ANCHOR_MODEL : 진입점 엣지(패턴→공정) 보강 패스만 상위 모델로 — 미설정 시 OPENAI_MODEL
# ANCHOR_PASSES: 그 보강 패스 반복 횟수(추출 비결정성 완화용, 기본 3)
#TOP_K=3
#ANCHOR_MODEL=gpt-5.5
#ANCHOR_PASSES=3
