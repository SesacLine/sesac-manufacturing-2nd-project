# ─────────────────────────────────────────────────────────────────────────────
# WAEFER 환경변수 예시 (.env_example)  —  저장소에서 **유일한** env 파일 정본
#   - `cp .env_example .env` 후 OPENAI_API_KEY / NEO4J_* 만 채우면 그대로 돈다.
#   - 값은 로컬 데모 기준값이다. 그대로 복사하면 안 되는 줄에는 ⚠️ 를 달아 뒀다.
#
# [규칙]
#   - 주석 처리된 변수(#VAR=...)는 두지 않는다. 끄고 싶으면 지우지 말고 **0으로 명시**할 것
#     — 코드 기본값이 "켜짐"인 변수(KG_SEMANTIC 등)는 지우는 순간 끌 방법이 사라진다.
#     설정하지 않는 게 정답인 변수(ANCHOR_MODEL·KG_SEMANTIC_MIN_SCORE)는 값 줄 대신
#     "왜 두지 않는가"를 주석으로만 남긴다.
#   - 정말 안 쓰는 기능만 삭제하고, 되살릴 근거 문서를 그 자리 주석에 남긴다(VLM open 트랙).
#   - 섹션 구조는 .env와 동일하게 유지할 것(두 파일 diff에 값 차이만 남도록).
#   - 새 변수를 코드에 추가하면 **같은 PR에서 이 파일도 고친다**(CLAUDE.md 규약).
#     비밀값(*_KEY·*_SECRET·*_PASSWORD·*_TOKEN)은 값을 비워 `KEY=` 형태로만 둔다.
#
# [0728 — env 파일은 이 하나뿐이다]
#   전에는 kg_rca/.env 가 따로 있었고 "실행 위치(cwd)에 따라 갈린다"고 적혀 있었는데
#   **틀린 설명**이었다. dotenv의 find_dotenv()는 cwd가 아니라 **호출한 .py 파일의
#   디렉터리**부터 위로 걷는다 — 그래서 kg_rca 스크립트는 cwd와 무관하게 항상
#   kg_rca/.env 를 읽었고, 루트 .env 는 영영 안 읽혔다(두 파일이 갈리면 조용히 어긋남).
#   kg_rca/.env 를 지우면 같은 탐색이 한 칸 더 올라와 이 루트 .env 를 찾는다. 그래서
#   지웠다. **kg_rca/.env 를 다시 만들지 말 것** — 만드는 순간 루트 .env가 무시된다.
#   (backend는 원래부터 루트 .env를 읽는다: backend/config.py·deps.py의 load_dotenv)
#   - kg_rca·secsgem-mcp는 이 repo 하위 폴더다(0713 통합) — 상대경로가 그대로 맞다.
# ─────────────────────────────────────────────────────────────────────────────

# ── 핵심 경로 ────────────────────────────────────────────────────────────────
# KG 산출물 — backend가 읽는 원인 후보 파일(KG_LIVE=0일 때 이 파일만 조회).
KG_HYPOTHESES_PATH=./kg_rca/outputs/hypotheses.json
# secsgem-mcp 서버 — MCP stdio 서브프로세스의 작업 디렉터리/모듈 경로.
MCP_SERVER_CWD=./secsgem-mcp
MCP_SERVER_PYTHONPATH=./secsgem-mcp
# fab.db — 시뮬레이터가 만든 가상 팹 데이터(읽기 전용, git 밖 — secsgem-mcp README "데이터 준비").
FAB_DB=./secsgem-mcp/datasets/fab.db
# 서비스 런타임 상태 — 배치 커서·배치 기록·분석 결과(지우면 첫 배치부터 다시).
APP_STATE_DB=./app_state.db
# CNN 체크포인트 — 없으면 판독이 전부 "Center"로 폴백해 그룹이 1개만 생긴다.
CNN_CKPT=./wafer_reading/classifier/checkpoints/resnet18_5cls.pt

# ── 서버 기준일 ──────────────────────────────────────────────────────────────
# 서버가 인식하는 "오늘"(벽시계 아님, 명세 §1). 배치는 이 날짜의 '전날'까지가 대상.
# 데이터가 2026-01~03월분이라 벽시계 now()를 쓰면 대상이 0건이 된다. 값은 데모 합의값.
# 이 값이 테스트로 새지는 않는다 — backend/tests/conftest.py가 명세 기본값(2026-04-01)으로
# 고정한다(SEED_UNTIL과 같은 "개발자 .env 오염" 차단).
EVENT_DATE=2026-02-06

# ── 데모 시딩 (backend/seed.py) ──────────────────────────────────────────────
# SEED_UNTIL: 서버 기동 시 **이 날짜까지의 과거 배치를 하루 한 건씩 자동으로 따라잡는다.**
#   시연은 "이미 며칠치가 쌓인 화면에서 오늘치를 눌러 누적"하는 흐름인데, 새로 올린 서버엔
#   그 이전 내역이 없다. 사람이 배치를 여러 번 눌러 만들던 준비를 서버가 대신하는 장치다.
#       버튼이 돌릴 날 = SEED_UNTIL + 1일   ·   화면1 '오늘' 배지 = SEED_UNTIL + 2일
#   날짜를 뒤로 옮기고 재시작하면 **그 차이 구간만** 이어서 돈다(중복 없음·중단 시 재개).
#   ⚠️ 배치마다 실제 LLM을 부른다 — 빈 DB 기준 약 35배치·2분·과금. 백그라운드라 기동은
#      막지 않는다. 저수율 로트가 없는 날은 ⓪에서 0건으로 끝나 LLM을 안 쓴다.
#   ⚠️ 값이 **빈 문자열이면 기능이 꺼진다**(= 로컬 기본). 데모 서버에서만 날짜를 넣을 것.
#      EVENT_DATE와 헷갈리지 않게 SEED_UNTIL + 2일 = EVENT_DATE로 맞춰 두면 편하다.
SEED_UNTIL=

# ── LLM — 역할 1개 = 변수 1개 ────────────────────────────────────────────────
# 정본: personalspace_rca/0726 work/모델지정_규약_설계서_v2.0.md §4
# 성격이 다른 역할이 한 스위치를 공유하면 한쪽을 튜닝할 때 나머지가 딸려 움직인다.
# 모델을 바꿀 땐 해당 역할 한 줄만 건드릴 것.
#
# ⚠️ temperature=0을 못 받는 모델(gpt-5.5·gpt-5.6 계열 — 1 고정 + top_p까지 거부)은
#    재현성이 필요한 역할(에이전트·번역·VLM·판정)에 넣지 말 것. 400으로 죽거나,
#    폴백으로 우회하면 실행마다 결과가 달라진다. 실측표는 설계서 v2.0 §3.1.
# ⚠️ 구 공통 폴백 `OPENAI_MODEL`은 **두지 않는다**(0728 제거). config.resolve_model이
#    아직 인식하긴 하지만, 두면 역할 변수를 빠뜨렸을 때 조용히 그 모델로 배치가 끝까지
#    돌아 결과 수치의 출처를 잃는다. 없으면 기동 시점에 RuntimeError로 크게 실패한다.
# ⚠️ 모델명은 **반드시 날짜 핀(스냅샷) 형태로 적는다.** `gpt-5.4` 같은 별칭은 OpenAI가
#    가리키는 스냅샷을 말없이 옮기기 때문에, 같은 .env로 같은 배치를 돌려도 어느 날부터
#    결과가 달라지고 그 변화를 코드/데이터 어디서도 설명할 수 없게 된다.
#    현행 핀표: gpt-5.4 → gpt-5.4-2026-03-05 · gpt-5.4-mini → gpt-5.4-mini-2026-03-17
#               gpt-5.5 → gpt-5.5-2026-04-23 · gpt-5.2     → gpt-5.2-2025-12-11
#    (역할 분리 검사는 영향 없다 — rubric_gen/models.py의 base_model()이 날짜를 벗겨낸다)
OPENAI_API_KEY=
RCA_AGENT_MODEL=gpt-5.4-2026-03-05     # ⑤ Hypothesis 자동 tier 에이전트
TRANSLATE_MODEL=gpt-5.4-2026-03-05     # ⑦ 응답 영→한 번역 (RESPONSE_LLM=1일 때만)
VLM_PTY_MODEL=gpt-5.4-2026-03-05       # ③ VLM 서술 pty 트랙
RUBRIC_GEN_MODEL=gpt-5.5-2026-04-23    # 루브릭 생성 (평가 전용 — 서비스 실행엔 불필요)
JUDGE_MODEL=gpt-5.2-2025-12-11         # LLM-as-Judge (평가 전용 — 서비스 실행엔 불필요)
# ↑ VLM/루브릭/판정 셋은 **서로 다른 세대여야 한다** — 같으면 자기평가 편향이 수치에
#   섞인다. 크기 변형(mini/nano/pro)도 같은 계열로 접어서 막는다(rubric_gen/models.py의
#   model_family + assert_distinct가 실행 시점에 검사).

# ── KG 구축 모델 (kg_rca 5·6번 전용 — 런타임 역할과 분리) ────────────────────
# 산출물(hypotheses.json)이 고정 대상이라 런타임 모델을 티어업해도 따라 오르면 안 된다.
# 값을 바꾸면 재빌드 시 산출물이 통째로 바뀐다.
# 0728: gpt-5.4-mini → gpt-5.4 승급. A/B 실측(16청크×3구성×2회, tools/ab_extract_models.py):
#   재현성  완전일치 5/16 → 12/16 (자카드 0.56 → 0.83)  ← P4 비결정성 대폭 완화
#   무효관계 청크당 0.8건 → 0.1건 (mini는 많이 뽑고 많이 틀린다)
#   진입엣지 0.9로 동일 → 앵커 보강 패스 3회(ANCHOR_PASSES 코드 기본값)는 유지해야 한다
# 0728 언어 규약: KG는 영어로 생성하고 한국어 전환은 **별도 번역 패스**가 전담한다.
#   한 LLM에 생성과 번역을 겹쳐 시키면 두 작업의 실패가 구분되지 않는다(③ VLM과 같은 경계).
#   번역은 빌드타임 1회로 끝나 산출물에 구워지므로 런타임 비용은 0이다.
# ⚠️ ANCHOR_MODEL / ANCHOR_PASSES는 **두지 않는다** — 미설정이 정답이다. ANCHOR_MODEL은
#    미설정 시 KG_EXTRACT_MODEL을 따라가는데, 값을 박으면 앵커 패스만 옛 모델에 남는다.
#    ANCHOR_PASSES는 코드 기본값 3이 실측 결론이라 굳이 덮을 이유가 없다.
# ⚠️ TOP_K(패턴별 가설 출력 상한)도 두지 않는다 — 미설정=전건 출력이 정본이고, 잘라 보고
#    싶으면 `TOP_K=3 python kg_rca/6_ask_graphrag.py` 처럼 일회성으로 줄 것.
# ⚠️ 여기도 날짜 핀 필수 — 오히려 여기가 더 중요하다. 산출물(hypotheses.json)이 어떤
#    스냅샷에서 나왔는지가 6번의 meta에 기록되는데, 별칭을 쓰면 그 기록이 "gpt-5.4"로만
#    남아 나중에 재현할 수가 없다. 코드 기본값은 별칭이 아니라 mini(gpt-5.4-mini)이니
#    이 세 줄을 지우면 모델이 통째로 내려간다 — 지우지 말 것.
KG_EXTRACT_MODEL=gpt-5.4-2026-03-05    # kg_rca 5번 (KG 추출)
KG_SYNTH_MODEL=gpt-5.4-2026-03-05      # kg_rca 6번 (문장 합성 — **영어**로만 생성)
KG_TRANSLATE_MODEL=gpt-5.4-2026-03-05  # kg_rca 6번 (영→한 번역 패스, 미설정=KG_SYNTH_MODEL)

# ── KG 의미 진입 임베딩 (KG_LIVE=1일 때만 의미 있음) ─────────────────────────
# VLM 자연어를 임베딩해 진입 시그니처를 고른다. KG_SEMANTIC=0으로 끄고, signature index
# 파일이 없거나 빌드 모델이 다르면 자동으로 꺼진다(enum/패턴 진입으로 계속 — 서버 안 죽음).
# 인덱스 경로 기본값은 kg_rca/outputs/signature_index.json — 옮겼을 때만
# KG_SIGNATURE_INDEX_PATH 를 추가할 것.
# 0728: small → **large** 교체(코드 기본값도 large). 근거는 실측 —
#   문턱이 가르는 건 정답 vs **무관**이다(형제 시그니처 혼동은 top-k·morphology_rank 몫).
#     text-embedding-3-small : 정답최소 0.335 / 무관최대 0.339 → 여유 -0.004 (분리 실패)
#     text-embedding-3-large : 정답최소 0.457 / 무관최대 0.338 → 여유 +0.119 → 하한 0.4
# ⚠️ 코드가 읽는 변수는 KG_EMBEDDING_MODEL **하나**다. `OPENAI_EMBEDDING_MODEL`은 파이썬
#    어디서도 안 읽는 죽은 변수라 0728에 삭제했다(그쪽을 고쳐도 아무 효과가 없었다).
# ⚠️ 모델을 바꾸면 인덱스를 **반드시 다시 만들어야 한다**(벡터가 파일에 구워져 있다):
#      python kg_rca/7_build_signature_index.py --reembed   ← 모델만 바뀐 경우(Neo4j 불필요)
#      python kg_rca/7_build_signature_index.py             ← 그래프도 바뀐 경우(Neo4j 필요)
KG_SEMANTIC=1
KG_EMBEDDING_MODEL=text-embedding-3-large
# 코사인 하한(KG_SEMANTIC_MIN_SCORE)은 **의도적으로 두지 않는다** — 모델별 실측표
# (semantic_entry.MIN_MATCH_SCORE_BY_MODEL, large=0.4)가 정본이고, 여기에 값을 박으면
# 모델을 바꿔도 "미보정" 경고가 뜨지 않아 옛 문턱을 조용히 쓰게 된다.
# 보정 도구: python kg_rca/tools/calibrate_semantic_threshold.py

# ── 실연동 스위치 (코드 기본값은 전부 off — 여기서만 켠다) ───────────────────
# 아래 3개는 **로컬 데모 기준값**이라 전부 켜져 있다. 그대로 복사하면 안 되는 경우가 있다.
#
# KG_LIVE : ④ KG 조회의 소스를 고르는 유일한 스위치(backend/deps.py의 kg_client()).
#             0 (또는 미설정) → KGClient      : KG_HYPOTHESES_PATH 파일만 조회. Neo4j 불필요.
#             1                → LiveKGClient  : Neo4j Aura를 요청마다 직접 순회 + 의미 진입.
#           두 클라이언트는 get_candidates(pattern, observation) 인터페이스가 같아서
#           ④ 노드는 어느 쪽인지 모르고 그대로 쓴다(drop-in).
#           ⚠️ 1로 두면 Aura 접속이 필수다 — 못 붙으면 ④에서 배치가 죽는다(Neo4jGraph가
#              생성 시점에 verify_connectivity()를 돌린다). 켜기 전에 먼저 확인:
#                  python kg_rca/1_test_connection.py
#           ⚠️ 그래프 리빌드 중에는 0으로 내려둘 것 — 반쯤 적재된 그래프가 라이브로 나간다.
#           ⚠️ 값 뒤에 공백을 남기지 말 것. dotenv는 스트립하지만 셸 export는 안 해서
#              "1 "이 되면 게이트에 안 걸리고 조용히 파일 모드로 떨어진다.
#           ⚠️ 프로세스 싱글턴이라 바꾸면 **서버 재시작 필요**(--reload면 자동).
#           0728부터 Neo4j는 Aura(관리형 클라우드)라 EC2 데모 서버도 같은 인스턴스를
#           바라본다 → 서버 .env에서도 1로 둘 수 있다(구 "서버엔 0" 지침 폐기).
# VLM_LIVE: 1이면 ③ 관측에 실제 VLM 자연어 서술을 얹는다(그룹마다 API 호출 = 과금).
#           0이면 결정적 관측(die-matrix)만 — 배치는 정상 동작. 실패해도 폴백된다.
# RESPONSE_LLM: 1이면 ⑦ 응답 카드 서술을 한국어로 번역(0이면 영어 원문, LLM 비용 0).
#           VLM은 영어만 생성하고 번역은 ⑦ 소관이라, VLM_LIVE=1이면 같이 켜는 게 맞다.
KG_LIVE=1
VLM_LIVE=1
RESPONSE_LLM=1

# ── VLM 트랙 ─────────────────────────────────────────────────────────────────
# pty(OpenAI API) | open(오픈웨이트 Qwen3-VL). open은 GPU 미확보로 **보류**다
# (0727 — personalspace_rca/0727 work/AWS_모델서빙_요구사항_v1.0.md 상단). 재개하려면 그
# 문서와 wafer_reading/vlm/serving/README.md 의 VLM_OPEN_* 변수를 참고해 되살릴 것.
VLM_TRACK=pty

# ── Neo4j (KG 재빌드 kg_rca 0~7번 + KG_LIVE=1 라이브 조회에 필요) ────────────
# 0728부터 **AuraDB(관리형)** — 로컬 설치 불필요. 콘솔(console.neo4j.io)에서 인스턴스를
# 만들면 자격증명 파일이 1회 내려온다(비밀번호는 그때만 표시되니 반드시 저장).
# URI 스킴이 bolt:// 가 아니라 **neo4j+s://**(TLS)다 — 코드는 그대로, 값만 바꾸면 된다.
# 자격증명 파일의 값을 그대로 옮겨 적을 것(USERNAME/DATABASE가 neo4j가 아닐 수 있다).
# AURA_* 2줄은 **코드가 읽지 않는다** — 자격증명 파일에 딸려 오는 인스턴스 식별용 메모라
# 남겨 둔다(인스턴스를 갈아탈 때 어느 것을 보고 있었는지 추적하는 용도).
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
AURA_INSTANCEID=
AURA_INSTANCENAME=

# ── 옵저버빌리티 (Langfuse Cloud) ────────────────────────────────────────────
# LANGFUSE_TRACING=1 **이면서** 키 2종이 있을 때만 켜진다(deps.langfuse_handler —
# 둘 중 하나만 있으면 경고만 찍고 비활성). 키를 채우기 전까지는 0으로 두는 게 맞다.
# 설계 정본: docs/node_langraph_spec/langfuse_observability_설계공유_v1.0.md
LANGFUSE_TRACING=0
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://jp.cloud.langfuse.com
# span export HTTP 타임아웃(초). 기본 5초는 원거리 리전+대형 span에 짧아 유실됐다.
LANGFUSE_TIMEOUT=60

# ── Windows 전용 TLS 우회 (Windows에서 Aura를 쓸 때만) ───────────────────────
# neo4j 드라이버 기본값인 Windows 인증서 저장소에 Aura 발급자(SSL.com) 루트가 없어
# TLS 검증이 실패한다("Unable to retrieve routing information"). certifi 번들을 보게 한다.
#
# ⚠️ 여기엔 **값 줄을 두지 않는다.** 경로가 사람마다 다른 데다, `SSL_CERT_FILE=`처럼 빈 값을
#    두면 OpenSSL이 빈 문자열을 인증서 파일 경로로 받아 오히려 TLS가 깨질 수 있다.
#    macOS/Linux·EC2에서는 아예 필요 없다.
#
# Windows에서 Aura를 쓸 때만, 아래를 실행해 나온 경로로 .env에 **직접 한 줄 추가**할 것:
#     python -c "import certifi;print(certifi.where())"
#     SSL_CERT_FILE=<위 출력 경로>
