# kg_rca 산출물 (Neo4j 라이브 쿼리 대신 우선 hypotheses.json 사용)
# kg_rca는 SesacLine_SemiRCA 밑의 하위 폴더다 (0713부터 — 공동작업 편하게 이 repo 안으로 옮기고
# 자체 .git은 지웠다. 이 repo를 git init하면 안의 파일까지 그대로 하나의 히스토리로 잡힌다).
KG_HYPOTHESES_PATH=./kg_rca/outputs/hypotheses.json

# KG 라이브 조회 (선택). 1이면 backend가 hypotheses.json 대신 Neo4j를 요청마다 직접 순회한다
# (LiveKGClient). NEO4J_* 변수 필요(kg_rca/.env 참고). 기본은 비활성(파일 조회).
#KG_LIVE=1
# 의미 진입 (KG_LIVE일 때만 의미 있음). VLM 자연어를 임베딩해 진입 시그니처를 고른다.
# signature index 파일이 있으면 자동 활성 — 0으로 명시하면 끔. 인덱스 기본 경로는
# kg_rca/outputs/signature_index.json (KG_SIGNATURE_INDEX_PATH로 재지정 가능).
# 임베딩 모델은 backend/graph_client/semantic_entry.py의 EMBEDDING_MODEL과 반드시 동일해야 함.
#KG_SEMANTIC=0
#KG_SIGNATURE_INDEX_PATH=./kg_rca/outputs/signature_index.json
# 의미 매칭 코사인 하한(기본 0.4 = semantic_entry.MIN_MATCH_SCORE). 미달이면 진입 시그니처 없음 —
# 기지 패턴은 패턴 레벨 원인만, Unknown은 candidates=[](insufficient_evidence 흐름).
#KG_SEMANTIC_MIN_SCORE=0.4

# secsgem-mcp 서버 (MultiServerMCPClient stdio 연결용, README 예시 참고)
# secsgem-mcp도 마찬가지로 SesacLine_SemiRCA 밑의 하위 폴더다 (0713부터, 자체 .git 삭제됨).
MCP_SERVER_CWD=./secsgem-mcp
MCP_SERVER_PYTHONPATH=./secsgem-mcp
FAB_DB=./secsgem-mcp/datasets/fab.db

# app_state.db (fab.db와 별개 — 커서/배치 결과 저장용, 서비스가 매번 씀)
APP_STATE_DB=./app_state.db

# 서버시간(고정 기준일, 명세 §1). 데이터가 2026-01~03월분이라 벽시계 now()를 쓰면 안 맞음 —
# 서버의 "오늘"은 이 값으로 고정된다(기본 2026-04-01 = 데이터축 직후). 다른 날짜로 테스트할 때만 변경.
#EVENT_DATE=2026-04-01

# VLM / 응답생성 LLM
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# 옵저버빌리티 (Langfuse Cloud, 선택 — LANGFUSE_TRACING=1일 때만 켜짐)
# 미설정/0이면 트레이싱 완전 비활성(CI·미설정 환경 무영향) — KG_LIVE/RESPONSE_LLM과 같은 관례.
#LANGFUSE_TRACING=1
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://jp.cloud.langfuse.com
# span export HTTP 타임아웃(초). 기본 5초는 원거리 리전+대형 span 업로드에 짧아 일부 유실됨 — 60초로 여유.
#LANGFUSE_TIMEOUT=60

# ③ VLM 판독 트랙. 기본은 pty(OpenAI API) — GPU 없이 그대로 돈다.
# open(오픈웨이트 Qwen3-VL)은 명시적 opt-in이며, VLM_LIVE=1이어야 자연어가 실제로 생성된다
# (VLM_LIVE 미설정이면 두 트랙 모두 호출되지 않고 결정적 관측만 만든다).
#VLM_LIVE=1
#VLM_TRACK=pty                              # pty | open

# --- 아래는 VLM_TRACK=open 일 때만 의미 있음 ---
# open 모델. 가중치는 **사전 다운로드 전제**이고 런타임에 받지 않는다.
#   준비: hf download Qwen/Qwen3-VL-8B-Instruct
#VLM_OPEN_MODEL=Qwen/Qwen3-VL-8B-Instruct
#VLM_OPEN_DEVICE_MAP=cuda:0                 # 로컬 모드 전용. 기본 cuda:0(GPU 없으면 auto)
#
# 원격 모드: 설정하면 모델을 프로세스에 올리지 않고 **OpenAI 호환 서버**(자체 호스팅 vLLM 등)를
# 호출한다 → GPU 없는 팀원도 open 트랙 사용 가능. 미설정이면 종전대로 로컬 로드(GPU 필요).
# 서빙·배포 정본: sdoubleoj/0727 work/VLM_오픈모델_서빙_설계서_v1.0.md
#VLM_OPEN_BASE_URL=http://localhost:8001/v1
#VLM_OPEN_API_KEY=                          # 원격 서버 토큰 (OPENAI_API_KEY와 별개)
#VLM_OPEN_SERVED_MODEL=                     # 서버가 다른 이름으로 모델을 알릴 때만 (기본=VLM_OPEN_MODEL)
