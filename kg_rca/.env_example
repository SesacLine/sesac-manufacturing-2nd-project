OPENAI_API_KEY=your_openai_api_key

# KG 구축 모델 — 미설정이 기본이다. 코드 기본값(gpt-5.4-mini)이 정본이며,
# 런타임 역할(RCA_AGENT_MODEL 등)과 **분리**돼 있어 티어업이 따라 오르지 않는다.
# 현행 hypotheses.json 772건이 이 모델 산출물이므로, 바꾸면 산출물이 통째로 바뀐다.
# 정본: sdoubleoj/0726 work/모델지정_규약_설계서_v2.0.md §1·§6-S1
#KG_EXTRACT_MODEL=gpt-5.4-mini
#KG_SYNTH_MODEL=gpt-5.4-mini
#ANCHOR_MODEL=                # 앵커 보강 패스만 상위 모델 (미설정 = KG_EXTRACT_MODEL)

# Neo4j — 0728부터 AuraDB(관리형 클라우드). 로컬 설치 불필요, URI 스킴은 neo4j+s://(TLS).
# ⚠️ 루트 .env_example 의 NEO4J_* 4줄과 **항상 같은 값**이어야 한다 — kg_rca 스크립트는
#    인자 없는 load_dotenv()라 실행 위치(repo 루트 / kg_rca)에 따라 읽는 파일이 갈린다.
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
