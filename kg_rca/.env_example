OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# ── KG 의미 진입 임베딩 (0728: small → large) ────────────────────────────────
# ⚠️ 코드가 읽는 변수는 KG_EMBEDDING_MODEL이다. OPENAI_EMBEDDING_MODEL은 어떤 코드도
#    읽지 않는 죽은 변수라 값만 바꿔도 아무 효과가 없다.
# 근거: tools/calibrate_semantic_threshold.py 실측 —
#   정답최소 vs 무관최대 여유가 small -0.004(분리 실패) / large +0.119, top-1 69% → 75%.
# ⚠️ 모델을 바꾸면 인덱스를 **반드시 다시 만들어야 한다**(차원 1536 → 3072):
#      python kg_rca/7_build_signature_index.py     ← 옵션 없이(그래프에서 새로)
KG_EMBEDDING_MODEL=text-embedding-3-large


# ── KG 구축 모델 (0728: mini → gpt-5.4 승급) ────────────────────────────────
# 루트 .env와 같은 값을 유지할 것 — 인자 없는 load_dotenv()라 실행 위치에 따라 갈린다.
# 근거: tools/ab_extract_models.py 실측 — 재현성 5/16 → 12/16, 무효관계 0.8 → 0.1건.
# ⚠️ ANCHOR_MODEL은 설정하지 말 것(미설정 = KG_EXTRACT_MODEL을 따라감).
KG_EXTRACT_MODEL=gpt-5.4
KG_SYNTH_MODEL=gpt-5.4
KG_TRANSLATE_MODEL=gpt-5.4

NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=
AURA_INSTANCEID=
AURA_INSTANCENAME=

# ⚠️ Windows 전용 — 이 줄이 없으면 Aura 접속이 TLS에서 죽는다("Unable to retrieve
#   routing information"). neo4j 드라이버는 기본으로 Windows 인증서 저장소를 쓰는데
#   이 PC에는 Aura 인증서 발급자(SSL.com) 루트가 없다. certifi 번들을 보게 한다.
#   **루트 .env에도 같은 줄이 있어야 한다** — 인자 없는 load_dotenv()라 실행 위치
#   (repo 루트 / kg_rca)에 따라 읽는 파일이 갈린다. 한쪽만 있으면 지금처럼 5번은 되고
#   6번은 죽는 식으로 갈린다.
#   경로 확인: python -c "import certifi;print(certifi.where())"
SSL_CERT_FILE=